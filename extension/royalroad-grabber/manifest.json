{
  "manifest_version": 3,
  "name": "webnovel-audio page grabber",
  "version": "0.5.0",
  "description": "Reads Royal Road pages in this tab for `webnovel-audio grab`: loads the page the program names, sends it back, shows its status.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.royalroad.com/fiction/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/extension",
        "http://localhost/extension"
      ],
      "js": [
        "announce.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
